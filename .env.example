# IdeaForge — Environment Variables
#
# API key routing:
#   ANTHROPIC_API_KEY  → ListenerAgent (concept extraction) + CuratorAgent (board layout)
#   OPENAI_API_KEY     → VisualizerAgent (DALL-E 3 image generation) + audio transcription (Whisper)
#
# If ANTHROPIC_API_KEY is set, it takes priority for all text/reasoning tasks.
# OPENAI_API_KEY is still required for image generation (DALL-E 3) and audio input (Whisper).

ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-proj-...

# Optional — Gemini API key (fallback image generation)
GEMINI_API_KEY=your-gemini-key-here
